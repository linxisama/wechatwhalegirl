# 运行环境与依赖
.venv-wechat/
.venv/
.tmp/
__pycache__/
*.pyc

# 运行数据（含消息库、插件状态、下载的图片与语音、模型缓存）
data/wechat-only/
data/models/
data/voice_inbox/
data/wechat-images/
logs/
wechatauto_logs/
wechatauto文件下载/

# 自检产物
out/

# 打包产物（程序目录、构建中间件、安装包；安装包要发给用户，但不必进版本库）
build/
dist/
installer/
.tmp-install-test/
# 打包工具与参考项目（含第三方仓库与二进制，不进版本库）
# 历史发布产物（安装包体积大，走 GitHub Releases 而不进版本库）
发布/
.build-tools/
.build-tools/build.log
.build-tools/install-verify.log
.build-tools/packaged-self-test.*

# 本地配置（含加密后的密钥；config.wechat.yaml 是模板，保留）
config.yaml
config.local.yaml
# 运行期数据（含消息库、插件状态、GUI 配置；升级时由程序自己维护，不进版本库）
data/

# 每轮构建/发布用的独立目录与临时文件（1.3.4x 起构建不再复用 dist、build）
build*/
dist*/
release/
out/
.tmp-*/
.tmp-*
package-lock.json

# 发布与打包日志
*.log
# 开发期备份、临时脚本与工具目录
*.bak-*
.workbuddy/
*.tmpmarket/
.tmp_*
